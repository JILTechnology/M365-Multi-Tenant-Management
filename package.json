{
  "name": "m365-multi-tenant-management",
  "productName": "M365 Multi Tenant Management",
  "version": "0.1.11",
  "description": "Desktop app for MSPs to manage multiple Microsoft 365 tenants with isolated browser sessions",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:editing": "node scripts/smoke-test-editing.mjs",
    "verify": "npm run typecheck && npm test",
    "package": "node scripts/require-code-signing.mjs && electron-forge package",
    "package:unsigned": "electron-forge package",
    "make": "node scripts/require-code-signing.mjs && electron-forge make",
    "make:unsigned": "electron-forge make",
    "audit:prod": "npm audit --omit=dev"
  },
  "keywords": [
    "electron",
    "react",
    "microsoft-365",
    "msp",
    "multi-tenant"
  ],
  "author": {
    "name": "JILTechnology",
    "email": "Andrew@jiltechnology.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JILTechnology/M365-Multi-Tenant-Management.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.8.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
